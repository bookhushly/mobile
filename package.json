    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@types/jest": "29.5.14",
    "aes-js": "^3.1.2",
    "expo": "~57.0.27",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
