#!/usr/bin/env bash
# Inspects exactly the refs being pushed (stdin: <local ref> <local sha> <remote ref> <remote sha>).
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deletion
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: refusing a non-fast-forward (force) push to $remote_ref." >&2; status=1
      fi ;;
  esac
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  # shellcheck disable=SC2086
  if git log --format=%B $range | grep -Eiq '^[[:space:]]*co-authored-by:.*(claude|anthropic)'; then
    echo "pre-push: commits for $remote_ref contain a Claude/Anthropic co-author trailer (owner rule)." >&2; status=1
  fi
done
exit $status
