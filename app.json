{
  "expo": {
    "name": "Bookhushly",
    "slug": "bookhushly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookhushly",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bookhushly.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bookhushly.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7FB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/RadioCanada_400Regular.ttf",
            "./assets/fonts/RadioCanada_500Medium.ttf",
            "./assets/fonts/RadioCanada_600SemiBold.ttf",
            "./assets/fonts/SourceSerif4_500Medium.ttf",
            "./assets/fonts/SourceSerif4_500Medium_Italic.ttf"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
