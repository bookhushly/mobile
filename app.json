{
  "expo": {
    "name": "Bookhushly",
    "slug": "book-h",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookhushly",
    "userInterfaceStyle": "light",
    "backgroundColor": "#7C3AED",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bookhushly.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["message"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.bookhushly.app",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.DETECT_SCREEN_CAPTURE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7C3AED",
          "image": "./assets/images/brand-mark-white.png",
          "imageWidth": 72
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HankenGrotesk_400Regular.ttf",
            "./assets/fonts/HankenGrotesk_500Medium.ttf",
            "./assets/fonts/HankenGrotesk_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "bookhushly"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bookhushly uses the camera to scan tickets at the door.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71d0cd71-ea71-415a-a8dd-e38e60d86711"
      }
    },
    "owner": "dnl-bookhushly",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/71d0cd71-ea71-415a-a8dd-e38e60d86711"
    }
  }
}
